# ============================================================
# COPY file này thành .env rồi điền thông tin MySQL của bạn.
# KHÔNG đổi tên biến bên trái dấu =
# KHÔNG push file .env lên GitHub.
# ============================================================

# mysql = kết nối MySQL thật
# memory = chạy thử bằng RAM, không cần database
APP_STORAGE=mysql

# Aiven: lấy Host ở Overview > Connection information
DB_HOST=your-mysql-host.aivencloud.com

# Aiven: port thường KHÔNG phải 3306, hãy lấy đúng port Aiven cấp
DB_PORT=12345

# Aiven thường có user mặc định là avnadmin
DB_USER=avnadmin

# Điền password của service user ở Aiven
DB_PASSWORD=your_password_here

# Dùng defaultdb nếu chưa tạo database riêng.
# Nếu đã tạo QuanLySinhVien trên Aiven thì đổi thành QuanLySinhVien.
DB_NAME=defaultdb

# Tùy chọn SSL CA.
# Để trống nếu bạn chưa tải CA certificate.
# Ví dụ: DB_SSL_CA=certs/ca.pem
DB_SSL_CA=
